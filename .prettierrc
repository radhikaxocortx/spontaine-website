{
    "singleQuote": true,
    "semi": false,
    "tabWidth": 2,
    "printWidth": 100,
    "trailingComma": "es5",
    "jsxSingleQuote": true,
    "bracketSpacing": true,
    "singleAttributePerLine": true,
    "plugins": [
        "prettier-plugin-organize-imports",
        "prettier-plugin-tailwindcss"
    ]
}
